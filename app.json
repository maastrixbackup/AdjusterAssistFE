{
  "expo": {
    "name": "AdjusterAssist",
    "slug": "AdjusterAssist",
    "version": "1.8.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adjusterassist",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adjusterassist.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "AdjusterAssist needs access to your photos to document claim damages.",
        "NSCameraUsageDescription": "AdjusterAssist needs camera access to take photos of claim damages.",
        "NSMicrophoneUsageDescription": "AdjusterAssist needs microphone access for voice-to-text claim updates.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.adjusterassist.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/ic_stat_download.png",
          "color": "#004AC0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AdjusterAssist needs access to your photos to document claim damages.",
          "cameraPermission": "AdjusterAssist needs camera access to take photos of claim damages."
        }
      ],
      "expo-document-picker",
      [
        "expo-av",
        {
          "microphonePermission": "AdjusterAssist needs microphone access for voice-to-text claim updates."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useAndroidX": true,
            "enableJetifier": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 34
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "34289344-f849-4bd5-ae0b-728b8cc40829"
      }
    }
  }
}
